registry.json
node_modules/

# pnpm's content-addressable store. Landed in git by accident in 83843fd7 — a
# `git add -A` alongside a two-file docker fix swept in 18,358 files — and
# nothing reads it from here: no .npmrc, no store-dir setting, no compose mount
# point at it. It is regenerable local cache, so it is ignored rather than
# vendored.
.pnpm-store/

*.log
.DS_Store
.idea/

# build output
dist/
*.tsbuildinfo

# local env
.env

# client build output
client/dist/

# claude code local state — scoped, not a blanket .claude/: this repo publishes
# itself as a plugin, so anything shared there (settings.json, agents, hooks)
# stays trackable. A worktree holds a `.git` file, so `git add -A` commits it as
# an embedded repo — a gitlink no clone can resolve — rather than as files.
.claude/worktrees/
.claude/settings.local.json
