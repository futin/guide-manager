<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.guide-manager</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__ROOT__/server/server.js</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- The server exits on a source change so this KeepAlive restart picks up
       fresh code; the same restart covers a genuine crash. ThrottleInterval is
       launchd's floor between respawns, so a reload lands within ~10s and a
       crash loop backs off instead of spinning. -->
  <key>ThrottleInterval</key><integer>10</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>GM_RESTART_ON_CHANGE</key><string>1</string>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/guide-manager.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/guide-manager.log</string>
</dict>
</plist>
