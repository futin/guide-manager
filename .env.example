# Copy to .env and adjust. The server reads these through @nestjs/config.

# Mongo is required at boot: no database, no server. `docker compose up -d mongo`
# starts the one this repo's compose file defines.
MONGO_URL=mongodb://localhost:27017/guide-manager

# HTTP port for the API, the guide render routes, and the built client bundle.
PORT=4321

# Absolute path to the registry bin/register.js writes. Defaults to
# ~/.guide-manager/registry.json when unset.
# GM_REGISTRY_FILE=/Users/you/.guide-manager/registry.json

# Host-side ports for `docker compose up`. Only needed when something else on
# this machine already holds one — inside the stack the ports are fixed.
# GM_WEB_PORT=5175
# GM_API_PORT=4321
# GM_MONGO_PORT=27017

# The tree `docker compose up` mounts read-only into the server container so
# registered guides resolve. Defaults to ~/Documents/custom-projects. Widen it
# only if you write guides elsewhere — a guide the container cannot see is
# dropped from the list silently, not reported as an error.
# GM_GUIDE_ROOT=/Users/you/Documents/custom-projects
