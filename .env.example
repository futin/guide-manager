# Copy to .env and adjust. The server reads these through @nestjs/config.

# Mongo is required at boot: no database, no server. `docker compose up -d mongo`
# starts the one this repo's compose file defines.
MONGO_URL=mongodb://localhost:27017/guide-manager

# HTTP port for the API, the guide render routes, and the built client bundle.
PORT=4321

# Absolute path to the registry bin/register.js writes. Defaults to
# ~/.guide-manager/registry.json when unset.
# GM_REGISTRY_FILE=/Users/you/.guide-manager/registry.json
